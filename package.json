{
  "name": "buzz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd sites/web dev",
    "build": "bun run --cwd sites/web build",
    "vercel-build": "bun scripts/vercel-build.mjs",
    "start": "bun run --cwd sites/web start",
    "preview": "bun run --cwd sites/web preview",
    "smoke": "bun scripts/smoke.mjs",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run test",
    "test": "bun --bun vitest run --project node && vitest run --project jsdom",
    "test:watch": "vitest",
    "test:ci": "bun scripts/ci-test.mjs",
    "lint": "bun run --cwd sites/web next typegen && eslint",
    "lint:fix": "bun run --cwd sites/web next typegen && eslint --fix",
    "typecheck": "bun --filter '@buzz/*' typecheck && tsrs --noEmit --fast -p tsconfig.json",
    "typecheck:tsc": "bun --filter '@buzz/*' typecheck:tsc && tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,mdx,css}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,mdx,css}\" --cache",
    "ui:add": "bun run --cwd sites/web shadcn add",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:seed:calendar": "bun run --cwd packages/db db:seed:calendar",
    "db:studio": "bun run --cwd packages/db db:studio"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "nodemailer": "^10.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "overrides": {
    "@vercel/cli-config>zod": "^4.6.7",
    "@esbuild-kit/core-utils>esbuild": "^0.25.12"
  }
}
