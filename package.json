{
  "name": "@buzz/discord-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Discord bot that tracks events, tasks and deadlines for a student organisation's events team.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "turbo run typecheck typecheck:tsc lint format:check test test:db --continue --concurrency=1",
    "gitleaks:install": "bash scripts/install-gitleaks.sh",
    "hooks:install": "git config core.hooksPath \"$(git rev-parse --show-prefix).githooks\"",
    "typecheck": "tsrs --noEmit --fast",
    "typecheck:tsc": "bun node_modules/typescript-7/bin/tsc --noEmit",
    "test": "bun test --isolate ./src ./scripts",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test:db": "bun test --parallel --timeout 30000 ./test/db/",
    "test:db:concurrency": "bun test --timeout 30000 --preload ./test/db-concurrency/preload.ts ./test/db-concurrency/",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "commands:register": "bun --env-file=.env scripts/register-commands.ts"
  },
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dbmate": "2.38.0",
    "eslint": "10.14.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/functions": "2.2.13",
    "discord-api-types": "0.38.58",
    "zod": "4.6.7"
  }
}
