# The public site needs NONE of this. It builds and deploys with an empty
# environment, because no marketing page reads the session or the database.
# Everything below turns the member portal on.
#
# Copy this file to ".env" beside it and fill it in. ".env" is gitignored.
# When you add a variable here, add it to the schema in "src/env.js" too.

# Postgres. buzz owns only the buzz_* tables, so this can point at an instance
# another project is already using.
DATABASE_URL="postgresql://postgres:password@localhost:5432/buzz"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application". Authorized redirect URIs must list every origin the
# portal runs on, each with the /api/auth/callback/google suffix:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
# A missing entry is what produces "redirect_uri_mismatch".
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Who gets the officer role. Comma-separated; an entry starting with @ matches
# a whole domain. It seeds the role on first sign-in and promotes an existing
# account on its next one. It never demotes — removing someone here does not
# revoke them, because access should not disappear when a variable is edited.
ADMIN_EMAILS="aamoghsawantt@gmail.com"
