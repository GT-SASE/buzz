{
  "name": "buzz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @buzz/web dev",
    "build": "pnpm --filter @buzz/web build",
    "start": "pnpm --filter @buzz/web start",
    "preview": "pnpm --filter @buzz/web preview",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "db:generate": "pnpm --filter @buzz/db db:generate",
    "db:migrate": "pnpm --filter @buzz/db db:migrate",
    "db:push": "pnpm --filter @buzz/db db:push",
    "db:studio": "pnpm --filter @buzz/db db:studio"
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.33.2"
}
