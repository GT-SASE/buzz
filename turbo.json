{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["ci"]
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "tags": ["ci"]
    },
    "test": {
      "tags": ["ci"]
    },
    "test:db": {
      "tags": ["ci"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "AUTH_URL",
        "AUTH_REDIRECT_PROXY_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "passThroughEnv": [
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "DATABASE_URL",
        "GMAIL_USER",
        "GMAIL_APP_PASSWORD",
        "MAIL_REPLY_TO",
        "VERCEL_URL"
      ]
    },
    // Turbo has no named input sets. A task with no script still gets a hash, and
    // every task that depends on it folds that hash into its own, so these two
    // carry the globs the root tasks below share. Each of those tasks lists only
    // package.json (always an input anyway), so its inputs are exactly these.
    "//#sources": {
      "inputs": [
        "$TURBO_ROOT$/sites/web/src/**",
        "$TURBO_ROOT$/sites/web/*.{ts,js,json}",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/*.{ts,json}",
        "$TURBO_ROOT$/packages/db/drizzle/**",
        "$TURBO_ROOT$/packages/db/scripts/**",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/*.{ts,json,mjs,toml}",
        "$TURBO_ROOT$/bun.lock",
        "!**/*.tsbuildinfo",
        "!**/next-env.d.ts"
      ]
    },
    // The bot's files, for the root tasks that read them (eslint and prettier).
    "//#bot-sources": {
      "inputs": [
        "$TURBO_ROOT$/sites/discord-bot/{api,src,scripts,test}/**",
        "$TURBO_ROOT$/sites/discord-bot/*.{ts,js,json}",
        "!**/*.tsbuildinfo"
      ]
    },
    "//#lint": {
      "inputs": ["package.json"],
      "dependsOn": ["//#sources", "//#bot-sources"],
      "tags": ["ci"]
    },
    "//#format:check": {
      "inputs": ["package.json"],
      "dependsOn": ["//#sources", "//#bot-sources"],
      "tags": ["ci"]
    },
    "//#typecheck:self": {
      "inputs": ["package.json"],
      "dependsOn": ["//#sources"],
      "tags": ["ci"]
    },
    "//#typecheck:tsc:self": {
      "inputs": ["package.json"],
      "dependsOn": ["//#sources"],
      "tags": ["ci"]
    },
    "//#test": {
      "inputs": ["package.json"],
      "dependsOn": ["//#sources"],
      "env": ["TEST_DATABASE_URL"],
      "tags": ["ci"]
    }
  }
}
