{
  "name": "@buzz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "db:seed:calendar": "node --disable-warning=ExperimentalWarning scripts/seed-fall-2026.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "drizzle-orm": "^0.45.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript-7": "npm:typescript@^7.0.0"
  }
}
