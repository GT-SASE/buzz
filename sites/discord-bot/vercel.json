{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../bun.lock",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
