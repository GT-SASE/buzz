{
  "name": "@buzz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "db:seed:calendar": "node --disable-warning=ExperimentalWarning scripts/seed-fall-2026.ts",
    "typecheck": "tsrs --noEmit --fast"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "drizzle-orm": "^0.45.4",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript-7": "npm:typescript@^7.0.0"
  }
}
